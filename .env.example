# ------------------------------------------------------------------------------
# ARCHIVO DE CONFIGURACIÓN DE EJEMPLO (.env.example)
# Copia este archivo a .env o .env.local y define tus credenciales reales.
# IMPORTANTE: Nunca expongas ni subas tus archivos .env reales al repositorio.
# ------------------------------------------------------------------------------

# URL de conexión a la base de datos PostgreSQL en producción o local (Requerido)
# Ejemplo: postgresql://usuario:contraseña@servidor:puerto/nombre_bd
DATABASE_URL=postgresql://postgres:contraseña_segura@localhost:5432/postgres

# Contraseña de acceso al núcleo de administración de WattSavvyHome (Requerido)
# Asegúrate de usar una contraseña larga y compleja.
ADMIN_PASSWORD=contraseña_compleja_y_segura_de_producción_123$

# Clave de API de DeepSeek para la generación de artículos con IA (Opcional)
DEEPSEEK_API_KEY=sk-deepseek-tu_api_key_aqui

# Configuración del servidor de correo SMTP para notificaciones (Opcional)
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=notificaciones@wattsavvyhome.com
SMTP_PASSWORD=tu_contraseña_de_aplicación_smtp
NOTIFICATION_EMAIL=administrador@wattsavvyhome.com
